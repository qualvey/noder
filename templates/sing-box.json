{
    "log": {
        "level": "warn",
        "timestamp": true
    },
    "experimental": {
        "clash_api": {
            "external_controller": "0.0.0.0:9090",
            "external_ui": "./zash",
            "external_ui_download_url": "https://github.com/Zephyruso/zashboard/releases/latest/download/dist.zip",
            "access_control_allow_private_network": true,
            "default_mode": "rule",
            "external_ui_download_detour": "Proxy"
        },
        "cache_file": {
            "enabled": true,
            "store_dns": true
        }
    },
    "http_clients": [
        {
            "tag": "Proxy",
            "detour": "Proxy"
        }
    ],
    "dns": {
        "servers": [
            {
                "tag": "google",
                "type": "udp",
                "server": "8.8.8.8",
                "detour": "Proxy"
            },
            {
                "tag": "ali",
                "type": "udp",
                "server": "223.5.5.5"
            },
            {
                "type": "fakeip",
                "tag": "fakeip",
                "inet4_range": "198.18.0.0/15",
                "inet6_range": "fc00::/18"
            }
        ],
        "rules": [
            {
                "rule_set": [
                    "category-ads-all"
                ],
                "action": "reject"
            },
            {
                "query_type": [
                    "SVCB",
                    "HTTPS",
                    "PTR"
                ],
                "action": "reject"
            },
            {
                "domain": [
                      "abs.twimg.com",
                      "pbs.twimg.com"

                ],
                "server": "fakeip"
            },
            {
                "domain": [
                        "pbs.twimg.com.cdn.cloudflare.net",
                        "abs.twimg.com.cdn.cloudflare.net"

                ],
                "client_subnet": "118.160.0.0/24",
                "server": "google"
            },
            {
                "clash_mode": "global",
                "server": "google"
            },
            {
                "type": "logical",
                "mode": "and",
                "rules": [
                    {
                        "rule_set": [
                            "gfw-site"
                        ],
                        "invert": true
                    },
                    {
                        "clash_mode": "direct"
                    }
                ],
                "server": "ali"
            },
            {
                "rule_set": [
                    "geosite-geolocation-cn"
                ],
                "server": "ali"
            }
        ],
        "strategy": "ipv4_only",
        "reverse_mapping": true,
        "optimistic": true,
        "final": "google"
    },
    "inbounds": [
        {
            "type": "mixed",
            "tag": "mixed",
            "listen": "127.0.0.1",
            "listen_port": 8080
        },
        {
            "tag": "tun-in",
            "interface_name": "sing-tun",
            "type": "tun",
            "address": [
                "172.19.0.0/30",
                "fdfe:dcba:9876::1/126"
            ],
            "mtu": 1400,
            "auto_route": true,
            "strict_route": true,
            "route_exclude_address": [
                "192.168.0.0/16",
                "fc00::/7",
                "116.62.232.15/32"
            ]
        }
    ],
    "outbounds": [
        {
            "type": "direct",
            "tag": "direct"
        },
        {
            "tag": "Proxy",
            "type": "selector",
            "interrupt_exist_connections": true,
            "outbounds": [
                "urltest"
            ]
        },
        {
            "tag": "urltest",
            "type": "urltest",
            "outbounds": []
        }
    ],
    "route": {
        "auto_detect_interface": true,
        "final": "Proxy",
        "default_domain_resolver": {
            "server": "ali"
        },
        "rules": [
            {
                "port": 853,
                "action": "reject"
            },
            {
                "action": "sniff"
            },
            {
                "rule_set": [
                    "category-ads-all"
                ],
                "action": "reject",
                "no_drop": true
            },
            {
                "protocol": "ssh",
                "action": "bypass",
                "outbound": "direct"
            },
            {
                "type": "logical",
                "mode": "or",
                "rules": [
                    {
                        "port": 53
                    },
                    {
                        "protocol": "dns"
                    }
                ],
                "action": "hijack-dns"
            },
            {
                "domain": "pbs.twimg.com",
                "action": "route-options",
                 "override_address": "pbs.twimg.com.cdn.cloudflare.net"
            },
                        {
                "domain": "abs.twimg.com",
                "action": "route-options",
                 "override_address": "abs.twimg.com.cdn.cloudflare.net"
            },
            {
                "clash_mode": "direct",
                "action": "bypass",
                "outbound": "direct"
            },
            {
                "type": "logical",
                "mode": "and",
                "rules": [
                    {
                        "protocol": [
                            "stun",
                            "dtls"
                        ]
                    }
                ],
                "outbound": "Proxy"
            },
            {
                "protocol": "bittorrent",
                "action": "bypass",
                "outbound": "direct"
            },
            {
                "protocol": "ntp",
                "outbound": "direct"
            },
            {
                "ip_is_private": true,
                "action": "bypass",
                "outbound": "direct"
            },
            {
                "clash_mode": "global",
                "outbound": "Proxy"
            },
            {
                "rule_set": "gfw-site",
                "outbound": "Proxy"
            },
            {
                "rule_set": [
                    "geosite-geolocation-cn",
                    "geosite-cn"
                ],
                "action": "bypass",
                "outbound": "direct"
            },
            {
                "rule_set": "geoip-cn",
                "action": "bypass",
                "outbound": "direct"
            },
            {
                "type": "logical",
                "mode": "and",
                "rules": [
                    {
                        "rule_set": "geoip-cn"
                    },
                    {
                        "rule_set": "geosite-geolocation-!cn",
                        "invert": true
                    }
                ],
                "action": "bypass",
                "outbound": "direct"
            }
        ],
        "rule_set": [
            {
                "tag": "geoip-cn",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs",
                "http_client": "Proxy"
            },
            {
                "tag": "geosite-geolocation-cn",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-geolocation-cn.srs",
                "http_client": "Proxy"
            },
            {
                "tag": "geosite-geolocation-!cn",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-geolocation-!cn.srs",
                "http_client": "Proxy"
            },
            {
                "tag": "geosite-cn",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs",
                "http_client": "Proxy"
            },
            {
                "tag": "douyin",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-douyin.srs"
            },
            {
                "tag": "category-ads-all",
                "type": "remote",
                "format": "binary",
                "url": "https://fastly.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-category-ads-all.srs",
                "http_client": "Proxy"
            },
            {
                "tag": "binance",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-binance.srs"
            },
            {
                "tag": "tiktok",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-tiktok.srs"
            },
            {
                "tag": "geosite-game!cn",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-category-games-!cn.srs"
            },
            {
                "tag": "geosite-bytedance!cn",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-bytedance@!cn.srs"
            },
            {
                "tag": "geosite-ebay",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/refs/heads/rule-set/geosite-ebay.srs"
            },
            {
                "tag": "rednote",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-xiaohongshu.srs"
            },
            {
                "type": "remote",
                "tag": "gfw-site",
                "url": "https://raw.githubusercontent.com/qualvey/rule-set/refs/heads/ruleset/singbox/version5/gfw-site.srs"
            },
            {
                "type": "remote",
                "tag": "gfw-ip",
                "url": "https://raw.githubusercontent.com/qualvey/rule-set/refs/heads/ruleset/singbox/version5/gfw-ip.srs"
            }
        ]
    }
}