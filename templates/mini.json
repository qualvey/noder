{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "level": "trace",
    "timestamp": true,
    "output": "box.log"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "sing-tun",
      "address": [
        "172.19.0.1/30"
      ],
      "mtu": 1400,
      "auto_route": true,
      "strict_route": true
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    // "auto_detect_interface": true,
    "default_interface": "enp2s0",
    "final": "direct"
  }
}