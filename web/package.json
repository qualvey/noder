{
  "name": "noder-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:pages": "vue-tsc --noEmit && vite build --config vite.pages.config.ts",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:strict": "vue-tsc --noEmit --noUnusedLocals --noUnusedParameters"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "qrcode.vue": "^3.11.0",
    "tailwind": "^4.0.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.10",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.2.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^2.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
