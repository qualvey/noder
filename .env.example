# Required: use a strong password in production.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=noder
POSTGRES_USER=noder

# Change these before exposing the service publicly.
ADMIN_SECRET_TOKEN=change-admin-token
MALL_SERVICE_SECRET=change-service-token
NODER_PORT=8000

# Used by compose.prod.yaml. GitHub CD overrides NODER_IMAGE_TAG with
# an immutable commit tag during deployment.
NODER_IMAGE=ghcr.io/qualvey/noder
NODER_IMAGE_TAG=latest
LEGACY_DATA_DIR=/var/lib/noder
