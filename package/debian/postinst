#!/usr/bin/env bash
# ===================================================================
# Noder Debian Package - Post-Installation Script
# ===================================================================

set -e

GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[0;33m'
PLAIN='\033[0m'

DATA_DIR="/var/lib/noder"
CONFIG_FILE="/etc/noder/noder.env"
SERVICE_NAME="noder.service"

case "$1" in
    configure)
        # 1. 保证持久化工作数据目录存在
        mkdir -p "${DATA_DIR}" "${DATA_DIR}/data/files"
        chmod 755 "${DATA_DIR}"

        # 自动平滑迁移旧版 /opt/sub-server 中的数据与文件
        OLD_DIR="/opt/sub-server"
        if [[ -f "${OLD_DIR}/data.db" ]]; then
            NEW_SIZE=$(stat -c%s "${DATA_DIR}/data.db" 2>/dev/null || echo 0)
            OLD_SIZE=$(stat -c%s "${OLD_DIR}/data.db" 2>/dev/null || echo 0)
            if [[ ! -f "${DATA_DIR}/data.db" || "${NEW_SIZE}" -lt "${OLD_SIZE}" ]]; then
                echo "[INFO] 检测到旧版数据库，正在迁移至 ${DATA_DIR}/data.db ..."
                cp -a "${OLD_DIR}/data.db" "${DATA_DIR}/data.db"
                if [[ -d "${OLD_DIR}/data/files" ]]; then
                    cp -rn "${OLD_DIR}/data/files/"* "${DATA_DIR}/data/files/" 2>/dev/null || true
                fi
            fi
        fi

        # 2. 检查并补全 /etc/noder/noder.env 中的 Token（优先保留旧版 Token）
        if [[ -f "${CONFIG_FILE}" ]]; then
            TOKEN_VAL=$(grep -E '^ADMIN_SECRET_TOKEN=' "${CONFIG_FILE}" | cut -d'=' -f2- | tr -d ' "\r\n' || true)
            if [[ -z "${TOKEN_VAL}" ]]; then
                # 尝试从旧版 sub-server.service 中提取原有 Token
                OLD_TOKEN=""
                for svc in /etc/systemd/system/sub-server.service /etc/systemd/system/sub-server.service.bak-old; do
                    if [[ -f "$svc" ]]; then
                        OLD_TOKEN=$(sed -n 's/.*ADMIN_SECRET_TOKEN="\([^"]*\)".*/\1/p' "$svc" | head -1)
                        [[ -n "$OLD_TOKEN" ]] && break
                    fi
                done
                if [[ -n "${OLD_TOKEN}" ]]; then
                    TOKEN_VAL="${OLD_TOKEN}"
                else
                    TOKEN_VAL=$(openssl rand -hex 16 2>/dev/null || head -c 16 /dev/urandom | tr -dc 'a-zA-Z0-9' | head -c 32 || echo "admin-secret-$(date +%s)")
                fi
                sed -i "s|^ADMIN_SECRET_TOKEN=.*|ADMIN_SECRET_TOKEN=${TOKEN_VAL}|g" "${CONFIG_FILE}"
            fi
            chmod 600 "${CONFIG_FILE}"
        fi

        # 3. 重新加载 Systemd 并配置自启
        if command -v systemctl &>/dev/null && [[ -d /run/systemd/system ]]; then
            # 兼容并清理旧版本可能残留的 sub-server 服务
            if [[ -f /etc/systemd/system/sub-server.service ]]; then
                systemctl stop sub-server 2>/dev/null || true
                systemctl disable sub-server 2>/dev/null || true
                mv /etc/systemd/system/sub-server.service /etc/systemd/system/sub-server.service.bak-old 2>/dev/null || true
            fi
            systemctl daemon-reload

            if systemctl is-active --quiet "${SERVICE_NAME}"; then
                # 升级场景：平滑重启
                systemctl restart "${SERVICE_NAME}"
            else
                # 全新安装：启用并拉起
                systemctl enable "${SERVICE_NAME}"
                systemctl start "${SERVICE_NAME}"
            fi

            # 4. 读取运行信息并打印欢迎 Banner
            CURRENT_PORT=$(grep -E '^PORT=' "${CONFIG_FILE}" 2>/dev/null | cut -d'=' -f2- | tr -d ' "\r\n' || echo "8000")
            CURRENT_TOKEN=$(grep -E '^ADMIN_SECRET_TOKEN=' "${CONFIG_FILE}" 2>/dev/null | cut -d'=' -f2- | tr -d ' "\r\n' || echo "admin-secret")
            CURRENT_PORT=${CURRENT_PORT:-8000}

            echo ""
            echo -e "${GREEN}====================================================${PLAIN}"
            echo -e "${GREEN} 🎉 Noder (Sing-Box Sub Middleman) 安装/升级成功！${PLAIN}"
            echo -e "${GREEN}====================================================${PLAIN}"
            echo -e " 🌐 控制台面板 : ${CYAN}http://localhost:${CURRENT_PORT}${PLAIN}"
            echo -e " 🔑 管理 Token : ${YELLOW}${CURRENT_TOKEN}${PLAIN}"
            echo -e " ⚙️ 配置文件   : ${CONFIG_FILE}"
            echo -e " 💾 数据库路径 : ${DATA_DIR}/data.db"
            echo -e " ⚡ 服务状态   : systemctl status ${SERVICE_NAME}"
            echo -e "${GREEN}====================================================${PLAIN}"
            echo ""
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        ;;
esac

exit 0
